# EASE 실험 환경 변수
# 이 파일을 .env로 복사한 후 실제 키를 입력하세요.
# .env 파일은 .gitignore에 포함되어 Git에 올라가지 않습니다.

# LLM API Keys
ANTHROPIC_API_KEY=your-key-here
OPENAI_API_KEY=your-key-here
GEMINI_API_KEY=your-key-here
DEEPSEEK_API_KEY=your-key-here # https://platform.deepseek.com 에서 발급
TOGETHER_API_KEY=your-key-here # https://api.together.xyz 에서 발급